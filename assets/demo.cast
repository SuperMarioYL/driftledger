{"version": 2, "width": 100, "height": 28, "timestamp": 1753267200, "title": "driftledger — catching plan drift at minute 20, not 88", "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.1, "o", "$ driftledger init -p plan.md\r\n"]
[0.6, "o", "wrote plan.md — edit the steps to match your task, then `driftledger watch plan.md trace.jsonl`\r\n"]
[1.0, "o", "\r\n$ # Your agent runs for ~20 minutes. A shim appends one JSONL line per action.\r\n"]
[2.2, "o", "$ # Minute 20: the agent abandons step-3 and chases a README tangent instead.\r\n"]
[3.4, "o", "$ cat > trace.jsonl <<'EOF'\r\n"]
[3.5, "o", "{\"ts\":\"2026-07-23T10:00:00Z\",\"step_id\":\"step-1\",\"action\":\"run\",\"summary\":\"initialized go module and added cmd package\"}\r\n"]
[3.6, "o", "{\"ts\":\"2026-07-23T10:20:00Z\",\"step_id\":\"step-2\",\"action\":\"run\",\"summary\":\"started a reconciler, punted on statuses\"}\r\n"]
[3.7, "o", "{\"ts\":\"2026-07-23T10:20:30Z\",\"step_id\":\"side-quest\",\"action\":\"run\",\"summary\":\"rewrote the README hero instead\"}\r\n"]
[3.8, "o", "EOF\r\n"]
[4.2, "o", "\r\n$ driftledger diff plan.md trace.jsonl\r\n"]
[4.8, "o", "plan 0.1.0  3 steps  3 trace events\r\n"]
[4.9, "o", "------\r\n"]
[5.0, "o", "step-1       matched     first-seen:2026-07-23T10:00:00Z\r\n"]
[5.1, "o", "step-2       drifting    first-seen:2026-07-23T10:20:00Z  unmet: matched; drifting; unexecuted\r\n"]
[5.2, "o", "step-3       unexecuted  first-seen:—\r\n"]
[5.3, "o", "side-quest   extra       first-seen:2026-07-23T10:20:30Z  summary: rewrote the README hero instead\r\n"]
[5.4, "o", "------\r\n"]
[5.5, "o", "matched:1  drifting:1  unexecuted:1  extra:1\r\n"]
[6.0, "o", "\r\n$ # The drift surfaces at minute 20, not the minute-88 post-mortem.\r\n"]
[7.2, "o", "$ # `driftledger watch plan.md trace.jsonl` renders the same ledger live; press `a` to accept a drift.\r\n"]
[8.6, "o", "$ jq . driftledger.ledger.jsonl 2>/dev/null || echo '(no accepts yet — run watch and press a)'\r\n"]
[9.4, "o", "(no accepts yet — run watch and press a)\r\n"]
[9.8, "o", "\r\n$ "]
